# --- MySQL (AWS RDS or local) ---
# Use the writer endpoint from RDS. Include ?ssl-mode=REQUIRED for RDS.
DB_HOST=your-instance.xxxxxxxxxxxx.eu-west-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=change-me
DB_NAME=landmark
DB_SSL=true

# --- Auth ---
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=12h

# Seeded on first `npm run db:seed`. Change immediately after logging in.
SEED_ADMIN_EMAIL=admin@landmark-portharcourt.ng
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Landmark Admin

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
