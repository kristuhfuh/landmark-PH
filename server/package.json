{
  "name": "landmark-portharcourt-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express + MySQL admin API for landmark-portharcourt.",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:schema": "node scripts/apply-schema.js",
    "db:seed": "node db/seed.js",
    "db:reset": "npm run db:schema && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  }
}
